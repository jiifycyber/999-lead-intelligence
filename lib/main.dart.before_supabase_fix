class IntelligenceShell extends StatefulWidget {
  const IntelligenceShell({super.key});

  @override
  State<IntelligenceShell> createState() => _IntelligenceShellState();
}

class _IntelligenceShellState extends State<IntelligenceShell> {
  int selected = 0;

  final pages = const [
    'Dashboard',
    'Leads',
    'CRM',
    'Marketing',
    'SEO',
    'Automation',
    'Communications',
    'AI Intelligence',
    'Analytics',
    'Admin',
    'Settings',
  ];

  final icons = const [
    Icons.dashboard_rounded,
    Icons.groups_rounded,
    Icons.account_tree_rounded,
    Icons.campaign_rounded,
    Icons.search_rounded,
    Icons.autorenew_rounded,
    Icons.chat_rounded,
    Icons.auto_awesome_rounded,
    Icons.analytics_rounded,
    Icons.admin_panel_settings_rounded,
    Icons.settings_rounded,
  ];

  void selectPage(int index) {
    setState(() => selected = index);
    if (Navigator.canPop(context)) Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    final desktop = MediaQuery.of(context).size.width >= 950;

    return Scaffold(
      drawer: desktop
          ? null
          : Drawer(
              width: MediaQuery.of(context).size.width * .78,
              backgroundColor: const Color(0xFF0C1225),
              child: SafeArea(child: _navigation()),
            ),
      body: Row(
        children: [
          if (desktop)
            SizedBox(
              width: 285,
              child: ColoredBox(
                color: const Color(0xFF0C1225),
                child: SafeArea(child: _navigation()),
              ),
            ),
          Expanded(
            child: Column(
              children: [
                _topBar(desktop),
                Expanded(
                  child: selected == 0
                      ? const DashboardPage()
                      : ModulePage(
                          title: pages[selected],
                          icon: icons[selected],
                        ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _navigation() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        const Padding(
          padding: EdgeInsets.fromLTRB(28, 28, 24, 28),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              CircleAvatar(
                radius: 34,
                backgroundColor: Color(0xFF4B4389),
                child: Icon(
                  Icons.radar_rounded,
                  size: 35,
                  color: Colors.white,
                ),
              ),
              SizedBox(height: 25),
              Text(
                '999 Market Intelligence',
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.w900,
                ),
              ),
              SizedBox(height: 8),
              Text(
                'AI Growth Command Center',
                style: TextStyle(
                  color: Color(0xFFA3A8B8),
                  fontSize: 15,
                ),
              ),
            ],
          ),
        ),
        const Divider(height: 1, color: Color(0xFF30364C)),
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.symmetric(vertical: 14),
            itemCount: pages.length,
            itemBuilder: (_, i) {
              final active = selected == i;
              return Padding(
                padding:
                    const EdgeInsets.symmetric(horizontal: 14, vertical: 3),
                child: ListTile(
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(14),
                  ),
                  tileColor:
                      active ? const Color(0xFF191B3D) : Colors.transparent,
                  leading: Icon(
                    icons[i],
                    color: active
                        ? const Color(0xFFC7B9FF)
                        : const Color(0xFFC5C7D4),
                  ),
                  title: Text(
                    pages[i],
                    style: TextStyle(
                      color: active
                          ? const Color(0xFFC7B9FF)
                          : const Color(0xFFE5E6ED),
                      fontWeight: active ? FontWeight.w700 : FontWeight.w500,
                    ),
                  ),
                  onTap: () => selectPage(i),
                ),
              );
            },
          ),
        ),
      ],
    );
  }

  Widget _topBar(bool desktop) {
    return Builder(
      builder: (context) => Container(
        height: 84,
        decoration: const BoxDecoration(
          color: Color(0xFF080D1C),
          border: Border(
            bottom: BorderSide(color: Color(0xFF262C3E)),
          ),
        ),
        padding: const EdgeInsets.symmetric(horizontal: 24),
        child: Row(
          children: [
            if (!desktop)
              IconButton(
                icon: const Icon(Icons.menu_rounded, size: 30),
                onPressed: () => Scaffold.of(context).openDrawer(),
              ),
            if (!desktop) const SizedBox(width: 8),
            Expanded(
              child: Text(
                pages[selected],
                style: const TextStyle(
                  fontSize: 28,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ),
            IconButton(
              onPressed: () {},
              icon: const Icon(Icons.notifications_none_rounded, size: 28),
            ),
            const SizedBox(width: 10),
            const CircleAvatar(
              radius: 26,
              backgroundColor: Color(0xFF4A4084),
              child: Icon(Icons.person_rounded, size: 30),
            ),
          ],
        ),
      ),
    );
  }
}

