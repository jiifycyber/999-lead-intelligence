  Future<void> _showOptimizeAllSafe(
    BuildContext context,
    List<dynamic> opportunities,
  ) async {
    if (opportunities.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('No SEO opportunities available yet.'),
        ),
      );
      return;
    }

    final plans = <Map<String, dynamic>>[];

    for (final raw in opportunities) {
      final row = Map<String, dynamic>.from(raw as Map);

      final query = (row['query'] ?? 'Unknown query').toString().trim();

      final impressions = (row['impressions'] as num?)?.toInt() ?? 0;

      final clicks = (row['clicks'] as num?)?.toInt() ?? 0;

      final position = (row['position'] as num?)?.toDouble() ?? 0.0;

      final ctr = (row['ctr'] as num?)?.toDouble() ?? 0.0;

      final impressionScore = (impressions.clamp(0, 50) / 50 * 35).round();

      int rankingScore;

      if (position <= 10) {
        rankingScore = 25;
      } else if (position <= 20) {
        rankingScore = 35;
      } else if (position <= 40) {
        rankingScore = 45;
      } else if (position <= 60) {
        rankingScore = 38;
      } else {
        rankingScore = 20;
      }

      final ctrScore = ctr <= 0
          ? 15
          : ctr < 2
              ? 12
              : ctr < 5
                  ? 8
                  : 4;

      final score = (impressionScore + rankingScore + ctrScore).clamp(0, 100);

      String priority;

      if (score >= 70) {
        priority = 'HIGH';
      } else if (score >= 45) {
        priority = 'MEDIUM';
      } else {
        priority = 'BUILD';
      }

      plans.add({
        'query': query,
        'impressions': impressions,
        'clicks': clicks,
        'position': position,
        'ctr': ctr,
        'score': score,
        'priority': priority,
        'title': '$query | Jiffy Roadside Assistance',
        'meta':
            'Need $query? Jiffy Roadside Assistance provides fast, dependable roadside help including jump starts, tire changes, lockouts and fuel delivery.',
      });
    }

    plans.sort(
      (a, b) => (b['score'] as int).compareTo(a['score'] as int),
    );

    if (!context.mounted) return;

    await showDialog<void>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: Row(
            children: [
              const Icon(Icons.auto_fix_high),
              const SizedBox(width: 8),
              const Expanded(
                child: Text(
                  'Agent Duke the Boss — Optimize All',
                ),
              ),
              Chip(
                label: Text('${plans.length}'),
              ),
            ],
          ),
          content: SizedBox(
            width: 760,
            height: 600,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'Agent Duke analyzed all current Google Search Console SEO opportunities.',
                ),
                const SizedBox(height: 14),
                Expanded(
                  child: ListView.separated(
                    itemCount: plans.length,
                    separatorBuilder: (_, __) => const Divider(height: 1),
                    itemBuilder: (_, index) {
                      final plan = plans[index];

                      final query = plan['query'].toString();

                      return ExpansionTile(
                        leading: CircleAvatar(
                          child: Text('${index + 1}'),
                        ),
                        title: Text(
                          query,
                          style: const TextStyle(
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        subtitle: Text(
                          '${plan['priority']} PRIORITY • '
                          '${plan['score']}/100 • '
                          '${plan['impressions']} impressions • '
                          '${plan['clicks']} clicks • '
                          'position ${(plan['position'] as double).toStringAsFixed(1)}',
                        ),
                        children: [
                          Padding(
                            padding: const EdgeInsets.fromLTRB(
                              16,
                              0,
                              16,
                              18,
                            ),
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                const Text(
                                  'Recommended SEO Title',
                                  style: TextStyle(
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                SelectableText(
                                  plan['title'].toString(),
                                ),
                                const SizedBox(height: 12),
                                const Text(
                                  'Meta Description',
                                  style: TextStyle(
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                SelectableText(
                                  plan['meta'].toString(),
                                ),
                                const SizedBox(height: 12),
                                const Text(
                                  'Automatic Optimization Plan',
                                  style: TextStyle(
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                const SizedBox(height: 6),
                                const Text(
                                  '• Strengthen keyword relevance\n'
                                  '• Improve title and meta description\n'
                                  '• Add local service-area content\n'
                                  '• Expand roadside service sections\n'
                                  '• Add FAQs\n'
                                  '• Add internal links\n'
                                  '• Strengthen Call Now / Request Service CTAs\n'
                                  '• Monitor impressions, CTR and ranking',
