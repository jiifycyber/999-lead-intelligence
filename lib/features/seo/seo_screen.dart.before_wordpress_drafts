Future<void> _showSeoOptimizer(
  BuildContext context, {
  required String query,
  required int impressions,
  required double position,
}) async {
  final cleanQuery = query.trim();

  final positionPoints = (100 - position.clamp(0.0, 100.0)).round();

  final opportunityScore = ((impressions * 4) + positionPoints).clamp(0, 100);

  String priority;
  if (opportunityScore >= 75) {
    priority = 'HIGH PRIORITY';
  } else if (opportunityScore >= 45) {
    priority = 'MEDIUM PRIORITY';
  } else {
    priority = 'BUILD OPPORTUNITY';
  }

  final title = '$cleanQuery | Jiffy Roadside Assistance';

  final meta =
      'Need $cleanQuery? Jiffy Roadside Assistance provides fast, dependable roadside help including jump starts, tire changes, lockouts and fuel delivery.';

  final h1 = cleanQuery
      .split(' ')
      .where((word) => word.isNotEmpty)
      .map((word) => '${word[0].toUpperCase()}${word.substring(1)}')
      .join(' ');

  if (!context.mounted) return;

  await showDialog<void>(
    context: context,
    builder: (dialogContext) => AlertDialog(
      title: const Row(
        children: [
          Icon(Icons.auto_awesome),
          SizedBox(width: 8),
          Expanded(
            child: Text('Agent Duke the Boss SEO Optimizer'),
          ),
        ],
      ),
      content: SizedBox(
        width: 600,
        child: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                cleanQuery,
                style: const TextStyle(
                  fontSize: 21,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 14),
              Wrap(
                spacing: 8,
                runSpacing: 8,
                children: [
                  Chip(
                    label: Text('$impressions impressions'),
                  ),
                  Chip(
                    label: Text(
                      'Position ${position.toStringAsFixed(1)}',
                    ),
                  ),
                  Chip(
                    label: Text(
                      '$priority • $opportunityScore/100',
                    ),
                  ),
                ],
              ),
              const Divider(height: 30),
              const Text(
                'Recommended SEO Title',
                style: TextStyle(fontWeight: FontWeight.bold),
              ),
              SelectableText(title),
              const SizedBox(height: 16),
              const Text(
                'Meta Description',
                style: TextStyle(fontWeight: FontWeight.bold),
              ),
              SelectableText(meta),
              const SizedBox(height: 16),
              const Text(
                'Recommended H1',
                style: TextStyle(fontWeight: FontWeight.bold),
              ),
              SelectableText(h1),
              const SizedBox(height: 16),
              const Text(
                'Automatic Optimization Plan',
                style: TextStyle(fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 6),
              const Text(
                '• Strengthen exact keyword relevance\n'
                '• Improve page title and meta description\n'
                '• Add local roadside-service content\n'
                '• Add jump-start, tire, lockout and fuel sections\n'
                '• Add service-area language\n'
                '• Add frequently asked questions\n'
                '• Add strong Call Now / Request Service buttons\n'
                '• Add internal links to related services\n'
                '• Improve local SEO wording\n'
                '• Monitor ranking and CTR after optimization',
              ),
              const SizedBox(height: 18),
              Text(
                'Agent Duke: Google is already showing Jiffy for '
                '"$cleanQuery". This optimization is designed to '
                'improve relevance and move the result higher.',
              ),
            ],
          ),
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.of(dialogContext).pop(),
          child: const Text('Close'),
        ),
        FilledButton.icon(
          onPressed: () {
            Navigator.of(dialogContext).pop();

            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(
                  'Optimization prepared for "$cleanQuery".',
                ),
              ),
            );
          },
          icon: const Icon(Icons.check_circle_outline),
          label: const Text('Save Optimization'),
        ),
      ],
    ),
  );
}

